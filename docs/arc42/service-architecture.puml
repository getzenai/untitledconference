@startuml
!theme plain

title SvelteKit Vibe Starter - Service Architecture

legend right
  |= Color |= Layer |
  | <#E3F2FD> | Application (SvelteKit) |
  | <#E8F5E9> | Services & Operations |
  | <#FFF3E0> | Data & Infrastructure |
  | <#F3E5F5> | External Services |
endlegend

package "SvelteKit Application" #E3F2FD {
  [Route Handlers] as routes
  note right of routes
    +page.server.ts (load + actions)
    +server.ts (API endpoints)
    Superforms for validation
  end note

  [Middleware] as middleware
  note right of middleware
    hooks.server.ts
    Auth session resolution
    Locale handling (Paraglide)
  end note

  [Config] as config
  note right of config
    Lazy Proxy pattern
    Env vars from .env or KV
    Feature flags derived
    from available secrets
  end note
}

package "Services & Operations" #E8F5E9 {
  package "Auth (Better Auth)" #C8E6C9 {
    [Better Auth] as auth
    note right of auth
      Sessions + tokens
      Email/password + GitHub OAuth
      Email verification
      Password reset
      Organization plugin
      Admin plugin
    end note
  }

  package "Documents" #C8E6C9 {
    [Document Operations] as docops
    note right of docops
      createDocument()
      loadDocument()
      updateDocument()
      deleteDocument()
      transformDocumentText()
    end note

    [Tiptap Validator] as tiptap
    note right of tiptap
      validateContentSize()
      validateJsonDepth()
      Content sanitization
    end note
  }

  package "AI Provider" #C8E6C9 {
    [AI Factory] as aifactory
    note right of aifactory
      AIProviderFactory.create()
      Selects provider by config
    end note

    [Azure OpenAI Provider] as azureoai
    [Mock Provider] as mockai
  }

  package "Communication" #C8E6C9 {
    [Email Service] as email
    note right of email
      sendEmail()
      SendGrid or console fallback
      Verification + reset templates
    end note

    [System Invitation] as sysinvite
    note right of sysinvite
      createSystemInvitation()
      markInvitationAsAccepted()
      pollForInvitationLink()
      listAllInvitations()
    end note
  }

  package "Organization Utils" #C8E6C9 {
    [Org Transfer] as orgtransfer
    note right of orgtransfer
      transferOwnershipSafely()
      Atomic owner change
      via Better Auth API
    end note
  }

  [Logger] as logger
  note right of logger
    Winston-based
    Human or JSON format
    LOG_LEVEL env config
  end note
}

package "Data Layer" #FFF3E0 {
  database "PostgreSQL" as db {
    [Drizzle ORM] as drizzle

    package "Schemas" {
      [auth-schema] as authschema
      note bottom of authschema
        user, session, account,
        verification, organization,
        member, invitation,
        systemInvitation
      end note

      [documents-schema] as docschema
      note bottom of docschema
        documentsTable
        userId FK, organizationId FK
        Tiptap JSON content
      end note

      [crud-example-schema] as crudschema
      note bottom of crudschema
        exampleObjectsTable
        Demo CRUD pattern
      end note
    }
  }
}

cloud "External Services" #F3E5F5 {
  [Infisical Cloud] as kv
  note bottom of kv
    All secrets except
    local Docker DB URLs
  end note

  [Azure PostgreSQL] as azuredb
  note bottom of azuredb
    Dev + test databases
    (or local Docker)
  end note

  [SendGrid] as sendgrid
  note bottom of sendgrid
    Transactional email
    Verification + reset
  end note

  [Azure OpenAI] as openai
  note bottom of openai
    Text transformation
    Document AI features
  end note

  [GitHub OAuth] as github
  note bottom of github
    Social login provider
  end note
}

' --- Dependencies ---
routes --> auth : session checks
routes --> docops : CRUD + AI transform
routes --> sysinvite : admin invitations
routes --> orgtransfer : org management
routes --> config : env vars

middleware --> auth : resolveSession
middleware --> config : env vars

docops --> drizzle : read/write documents
docops --> aifactory : AI transforms
docops --> tiptap : content validation
docops --> logger

aifactory --> azureoai : when azure config present
aifactory --> mockai : fallback / testing
aifactory --> config : provider selection

auth --> drizzle : user/session/org data
auth --> email : verification emails

email --> sendgrid : send mail
email --> config : API keys

sysinvite --> drizzle : invitation records
sysinvite --> logger

orgtransfer --> auth : Better Auth API

drizzle --> azuredb : connection
config --> kv : secret retrieval
auth --> github : OAuth flow

@enduml
