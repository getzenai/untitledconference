@startuml
!theme plain

title SvelteKit Vibe Starter - API Surface Map

legend right
  |= Symbol |= Meaning |
  | GET | Page load / data fetch |
  | POST | Form action |
  | -> | Redirect |
  | (auth) | Auth required |
  | (admin) | Admin only |
endlegend

package "Root" #EEEEEE {
  component "/" as root
  note right of root
    GET -> /home (authenticated)
    GET -> /login (unauthenticated)
  end note
}

package "(public) - No Auth Required" #E8F5E9 {
  component "/login" as login
  note bottom of login
    Client-only form (Better Auth)
    Social: GitHub OAuth
  end note

  component "/register" as register
  note bottom of register
    Client-only form (Better Auth)
    Social: GitHub OAuth
  end note

  component "/forgot-password" as forgotpw
  note bottom of forgotpw
    Client-only form (Better Auth)
    Sends reset email
  end note

  component "/reset-password" as resetpw
  note bottom of resetpw
    Client-only form (Better Auth)
    Token from email link
  end note

  component "/verify-email" as verifyemail
  note bottom of verifyemail
    Client-only (Better Auth)
    Token from email link
  end note

  component "/invite/[code]" as invite
  note bottom of invite
    GET: validates invitation code
    Checks UUID, expiry, status
    Joins invitation + organization
  end note

  component "/complete-registration" as completereg
  note bottom of completereg
    GET: validates reset link token
    Returns form + email + validity
  end note
}

package "(protected) - Auth Required" #E3F2FD {
  component "/home" as home
  note bottom of home
    GET: dashboard landing page
    With sidebar layout
  end note

  component "/email-verified" as emailverified
  note bottom of emailverified
    GET: confirmation page
  end note

  package "Documents" #BBDEFB {
    component "/documents" as docs
    note bottom of docs
      GET: list user documents
      POST create: new document -> /documents/{id}
      POST delete: remove document
    end note

    component "/documents/[id]" as docid
    note bottom of docid
      GET: load single document
      POST update: title + content
      POST delete: -> /documents
      POST transformText: text transform
      POST aiTransform: AI via OpenAI
    end note
  }

  package "Examples (with sidebar)" #BBDEFB {
    component "/examples/crud" as crud
    note bottom of crud
      GET: list examples
      POST create: new example
    end note

    component "/examples/crud/[id]" as crudid
    note bottom of crudid
      GET: load example
      POST update: name + desc
      POST delete: -> /examples/crud
    end note

    component "/examples/superforms" as superforms
    note bottom of superforms
      GET: form demo
      POST default: validate + return
    end note

    component "/examples/drag-drop" as dragdrop
    component "/examples/paraglide" as paraglide
    component "/examples/toast" as toast
    component "/examples/ui-components" as uicomp
  }

  package "Settings (with sidebar)" #BBDEFB {
    component "/settings/account" as account
    note bottom of account
      GET: account form (superform)
      Client-side updates via Better Auth
    end note

    component "/settings/organization" as orgroot
    note bottom of orgroot
      GET -> /settings/organization/{slug}
      GET -> /settings/organization/new
    end note

    component "/settings/organization/new" as orgnew
    note bottom of orgnew
      GET: create org form
      Client-side via Better Auth API
      -> existing org if already has one
    end note

    component "/settings/organization/[slug]" as orgslug
    note bottom of orgslug
      GET: org detail + members + invitations
      POST inviteMember
      POST updateMemberRole
      POST removeMember
      POST cancelInvitation
      POST leaveOrganization -> /settings/organization
      POST acceptInvitation
      POST rejectInvitation
    end note
  }
}

package "(admin) - Admin Only" #FFF3E0 {
  component "/admin/users" as adminusers
  note bottom of adminusers
    GET: all users + stats + invitations
    POST createInvitation: email + role
    POST createUser: direct creation
    POST regenerateInvitation
    POST setEmailVerification
  end note
}

package "API Routes (Better Auth)" #F3E5F5 {
  component "/api/auth/[...all]" as authapi
  note bottom of authapi
    Better Auth catch-all handler
    Sessions, OAuth, email verify,
    password reset, organizations
  end note
}

@enduml
