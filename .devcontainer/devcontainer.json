{
	"name": "SvelteKit Vibe Starter",
	"dockerComposeFile": "docker-compose.yml",
	"service": "app",
	"workspaceFolder": "/workspace",

	// Features to add to the dev container
	"features": {
		"ghcr.io/devcontainers/features/github-cli:1": {}
	},

	// Host requirements for the dev container
	"hostRequirements": {
		"memory": "16gb"
	},

	// Configure tool-specific properties
	"customizations": {
		"codespaces": {
			"openFiles": [".devcontainer/README.md"]
		},
		"vscode": {
			"extensions": [
				"svelte.svelte-vscode",
				"esbenp.prettier-vscode",
				"dbaeumer.vscode-eslint",
				"bradlc.vscode-tailwindcss",
				"vitest.explorer"
			],
			"settings": {
				"editor.formatOnSave": true,
				"editor.defaultFormatter": "esbenp.prettier-vscode",
				"[svelte]": {
					"editor.defaultFormatter": "svelte.svelte-vscode"
				},
				"svelte.enable-ts-plugin": true,
				"tailwindCSS.experimental.classRegex": [
					["cn\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
					["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"]
				],
				"files.associations": {
					"*.css": "tailwindcss"
				},
				"editor.quickSuggestions": {
					"strings": "on"
				}
			}
		}
	},

	// Port forwarding
	"forwardPorts": [5173, 5174, 5432, 5433, 5555],
	"portsAttributes": {
		"5173": {
			"label": "SvelteKit Dev Server",
			"onAutoForward": "notify"
		},
		"5174": {
			"label": "SvelteKit E2E Test Server",
			"onAutoForward": "silent"
		},
		"5432": {
			"label": "PostgreSQL Dev DB",
			"onAutoForward": "silent"
		},
		"5433": {
			"label": "PostgreSQL Test DB",
			"onAutoForward": "silent"
		},
		"5555": {
			"label": "Drizzle Studio",
			"onAutoForward": "notify"
		}
	},

	// Commands to run after container is created
	"postCreateCommand": "bash .devcontainer/post-create.sh",

	// Environment variables
	"containerEnv": {
		"CLAUDE_CONFIG_DIR": "/home/node/.config/claude"
	},

	// Uncomment to connect as root instead
	// "remoteUser": "root",
	"remoteUser": "node",

	// Specify secrets that the development environment needs
	"secrets": {
		"CLAUDE_CODE_OAUTH_TOKEN": {
			"description": "OAuth token for Claude Code CLI. Generate with 'claude setup-token' on your local machine.",
			"documentationUrl": "https://docs.anthropic.com/en/docs/claude-code"
		},
		"GITHUB_CLIENT_ID": {
			"description": "(Optional) GitHub OAuth App Client ID - only needed if you want to enable 'Sign in with GitHub'",
			"documentationUrl": "https://docs.github.com/en/apps/oauth-apps/building-oauth-apps/creating-an-oauth-app"
		},
		"GITHUB_CLIENT_SECRET": {
			"description": "(Optional) GitHub OAuth App Client Secret - only needed if you want to enable 'Sign in with GitHub'",
			"documentationUrl": "https://docs.github.com/en/apps/oauth-apps/building-oauth-apps/creating-an-oauth-app"
		}
	}
}
