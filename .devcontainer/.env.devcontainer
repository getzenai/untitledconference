# Development Database - using Docker service names for devcontainer
DATABASE_URL="postgres://root:mysecretpassword@project-db:5432/local"

# Test Database - using Docker service name and port 5432 (internal container port)
TEST_DATABASE_URL="postgres://root:mysecretpassword@test-db:5432/test"

# Better Auth Configuration
BETTER_AUTH_SECRET="dev_codespaces_default_secret_change_in_production"
BETTER_AUTH_URL="http://localhost:5173"

# Node Environment
NODE_ENV="development"

# GitHub OAuth (Optional - provided via Codespace secrets)
# These will be populated from Codespace secrets if configured
GITHUB_CLIENT_ID="${GITHUB_CLIENT_ID:-}"
GITHUB_CLIENT_SECRET="${GITHUB_CLIENT_SECRET:-}"
