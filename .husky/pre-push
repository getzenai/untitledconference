#!/bin/bash
# Pre-push hook: unit tests always, integration + E2E when services detected.
# Pre-commit already handles lint/format/build — this hook focuses on tests.

set -euo pipefail

echo "=== Pre-push: Unit tests ==="
npm run test:unit

# Opportunistic: integration tests if test DB is available
if pg_isready -h localhost -p 5433 -q 2>/dev/null; then
  echo "=== Pre-push: Integration tests (test DB detected on port 5433) ==="
  TEST_DATABASE_URL="${TEST_DATABASE_URL:-postgres://root:mysecretpassword@localhost:5433/test}" BETTER_AUTH_SECRET="${BETTER_AUTH_SECRET:-test-secret-for-hooks}" npm run test:integration
else
  echo "(Test DB not running on port 5433 — skipping integration tests)"
fi

# Opportunistic: E2E tests if test DB is available (Playwright starts its own server on :5174)
if pg_isready -h localhost -p 5433 -q 2>/dev/null; then
  echo "=== Pre-push: E2E tests (test DB detected — Playwright starts its own server on :5174) ==="
  TEST_DATABASE_URL="${TEST_DATABASE_URL:-postgres://root:mysecretpassword@localhost:5433/test}" BETTER_AUTH_SECRET="${BETTER_AUTH_SECRET:-test-secret-for-hooks}" npm run test:e2e
else
  echo "(Test DB not running on port 5433 — skipping E2E tests)"
fi
