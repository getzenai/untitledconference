{
	"name": "untitledconference",
	"private": true,
	"version": "0.0.1",
	"license": "MIT",
	"description": "Run a conference programme from the open call to the published agenda.",
	"type": "module",
	"scripts": {
		"dev": "./scripts/infisical/dev-from-infisical.sh",
		"dev:vite": "vite dev --host",
		"build": "vite build && npm run build:worker",
		"build:worker": "esbuild src/lib/server/jobs/worker.ts --bundle --platform=node --format=esm --packages=external --outfile=build/worker.js",
		"preview": "vite preview",
		"prepare": "husky || true && (svelte-kit sync || echo '')",
		"check": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy localStorage url preferredLanguage baseLocale --silent && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy localStorage url preferredLanguage baseLocale --silent && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"tokens": "tsx scripts/build-tokens.ts",
		"lint": "prettier --check . && eslint . --max-warnings 85",
		"lint:format": "prettier --write . && eslint . --max-warnings 85",
		"test": "npm run test:unit && npm run test:integration && npm run test:e2e",
		"test:unit": "vitest run --project unit",
		"test:integration": "node scripts/test/with-isolated-db.mjs -- vitest run --project integration",
		"test:e2e": "node scripts/test/with-isolated-db.mjs -- ./scripts/run-e2e.sh",
		"test:e2e:open": "node scripts/test/with-isolated-db.mjs -- ./scripts/run-e2e.sh open",
		"test:e2e:headed": "node scripts/test/with-isolated-db.mjs -- ./scripts/run-e2e.sh --headed",
		"test:e2e:spec": "node scripts/test/with-isolated-db.mjs -- ./scripts/run-e2e.sh --spec",
		"test:all": "./scripts/test-all.sh",
		"db:push": "./scripts/infisical/dev-from-infisical.sh npx drizzle-kit push",
		"db:push:force": "./scripts/infisical/dev-from-infisical.sh npx drizzle-kit push --force",
		"db:push:test": "./scripts/infisical/dev-from-infisical.sh bash -c 'DATABASE_URL=\"$TEST_DATABASE_URL\" npx drizzle-kit push --force'",
		"db:generate": "./scripts/infisical/dev-from-infisical.sh npx drizzle-kit generate",
		"db:baseline": "./scripts/infisical/dev-from-infisical.sh node scripts/db/baseline-migrations.mjs",
		"db:migrate": "./scripts/infisical/dev-from-infisical.sh npx drizzle-kit migrate",
		"jobs:worker:dev": "./scripts/infisical/dev-from-infisical.sh npx tsx watch src/lib/server/jobs/worker.ts",
		"jobs:worker": "node build/worker.js",
		"db:studio": "./scripts/infisical/dev-from-infisical.sh npx drizzle-kit studio",
		"check:unused": "knip",
		"dev:cf": "wrangler dev",
		"build:cf": "vite build"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260809.1",
		"@eslint/compat": "^1.4.1",
		"@eslint/js": "^9.39.2",
		"@inlang/paraglide-js": "^2.4.0",
		"@inlang/plugin-m-function-matcher": "^2.1.0",
		"@inlang/plugin-message-format": "^4.0.0",
		"@internationalized/date": "^3.9.0",
		"@lucide/svelte": "^0.574.0",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.43.5",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.13",
		"@tanstack/table-core": "^8.21.3",
		"@types/winston": "^2.4.4",
		"autoprefixer": "^10.4.21",
		"bits-ui": "^2.11.4",
		"clsx": "^2.1.1",
		"cypress": "^15.19.0",
		"dotenv": "^17.2.2",
		"drizzle-kit": "^0.31.5",
		"esbuild": "^0.25.12",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.12.4",
		"formsnap": "^2.0.1",
		"globals": "^16.5.0",
		"husky": "^9.1.7",
		"knip": "^5.84.0",
		"lucide-svelte": "^0.574.0",
		"mode-watcher": "^1.1.0",
		"paneforge": "^1.0.2",
		"patch-package": "^8.0.0",
		"prettier": "~3.8.1",
		"prettier-plugin-organize-imports": "^4.3.0",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"start-server-and-test": "^3.0.12",
		"svelte": "^5.39.6",
		"svelte-check": "^4.3.2",
		"svelte-sonner": "^1.0.5",
		"sveltekit-superforms": "^2.27.1",
		"tailwind-merge": "^3.3.1",
		"tailwind-variants": "^3.1.1",
		"tailwindcss": "^4.1.13",
		"tsx": "^4.23.11",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.44.1",
		"vaul-svelte": "^1.0.0-next.7",
		"vite": "^7.1.7",
		"vitest": "^4.0.18",
		"wrangler": "^4.120.0"
	},
	"dependencies": {
		"@ai-sdk/azure": "^3.0.30",
		"@ai-sdk/svelte": "^4.0.90",
		"@better-auth/oauth-provider": "^1.6.26",
		"@better-auth/passkey": "^1.6.26",
		"@milkdown/kit": "^7.22.0",
		"@modelcontextprotocol/sdk": "^1.30.0",
		"@opentelemetry/api-logs": "^0.221.0",
		"@opentelemetry/exporter-logs-otlp-http": "^0.221.0",
		"@opentelemetry/resources": "^2.10.0",
		"@opentelemetry/sdk-logs": "^0.221.0",
		"@sendgrid/mail": "^8.1.6",
		"@zxcvbn-ts/core": "^3.0.4",
		"@zxcvbn-ts/language-common": "^3.0.4",
		"@zxcvbn-ts/language-en": "^3.0.2",
		"ai": "^6.0.90",
		"better-auth": "^1.6.26",
		"dompurify": "^3.2.7",
		"drizzle-orm": "^0.45.1",
		"mammoth": "^1.11.0",
		"nanoid": "^5.1.6",
		"pdfjs-dist": "^6.2.108",
		"pg-boss": "^12.27.0",
		"postgres": "^3.4.7",
		"posthog-js": "^1.414.0",
		"posthog-node": "^5.48.1",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"unified": "^11.0.5",
		"winston": "^3.17.0",
		"winston-transport": "^4.9.0",
		"xlsx": "^0.18.5",
		"zod": "^4.1.11"
	},
	"overrides": {
		"comment": "Override Zod v3 dependencies to use v4 to fix TypeScript conflicts between sveltekit-superforms (uses v3) and Better Auth (requires v4). See: https://github.com/ciscoheat/sveltekit-superforms/issues/630",
		"zod@^3.24.6": "^4.1.5"
	}
}
