{
	"name": "sveltekit-vibe-starter",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev --host",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "husky || true && (svelte-kit sync || echo '')",
		"check": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy localStorage url preferredLanguage baseLocale --silent && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy localStorage url preferredLanguage baseLocale --silent && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "prettier --check . && eslint . --max-warnings 60",
		"lint:format": "prettier --write . && eslint . --max-warnings 60",
		"test": "npm run test:unit && npm run test:integration && npm run test:e2e",
		"test:unit": "vitest run --project unit",
		"test:integration": "vitest run --project integration",
		"test:e2e": "LOG_LEVEL=warn playwright test",
		"test:e2e:ui-mode": "LOG_LEVEL=warn playwright test --ui",
		"test:e2e:failed": "LOG_LEVEL=warn playwright test --last-failed",
		"test:e2e:list": "LOG_LEVEL=warn playwright test --list",
		"test:e2e:show-report": "npx playwright show-report",
		"db:start": "docker compose up",
		"db:push": "drizzle-kit push",
		"db:push:force": "drizzle-kit push --force",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"psql:dev": "dotenv -e .env -- bash -c 'if [[ \"$DATABASE_URL\" =~ ^postgres://.*@(localhost|127\\.0\\.0\\.1|project-db): ]]; then psql \"$DATABASE_URL\" -c \"$@\"; else echo \"Error: Only localhost/project-db connections allowed for safety\"; exit 1; fi' --",
		"psql:test": "dotenv -e .env -- bash -c 'if [[ \"$TEST_DATABASE_URL\" =~ ^postgres://.*@(localhost|127\\.0\\.0\\.1|test-db): ]]; then psql \"$TEST_DATABASE_URL\" -c \"$@\"; else echo \"Error: Only localhost/test-db connections allowed for safety\"; exit 1; fi' --",
		"check:unused": "knip",
		"docs:dev": "vitepress dev docs",
		"docs:build": "vitepress build docs",
		"docs:preview": "vitepress preview docs"
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.0",
		"@eslint/js": "^9.36.0",
		"@inlang/paraglide-js": "^2.4.0",
		"@inlang/plugin-m-function-matcher": "^2.1.0",
		"@inlang/plugin-message-format": "^4.0.0",
		"@internationalized/date": "^3.9.0",
		"@lucide/svelte": "^0.544.0",
		"@playwright/test": "^1.55.1",
		"@sveltejs/adapter-node": "^5.3.2",
		"@sveltejs/kit": "^2.43.5",
		"@sveltejs/vite-plugin-svelte": "^6.2.1",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.13",
		"@tanstack/table-core": "^8.21.3",
		"@types/winston": "^2.4.4",
		"@zenai/playwright-coding-agent-reporter": "^1.2.1",
		"autoprefixer": "^10.4.21",
		"bits-ui": "^2.11.4",
		"clsx": "^2.1.1",
		"dotenv": "^17.2.2",
		"dotenv-cli": "^10.0.0",
		"drizzle-kit": "^0.31.5",
		"eslint": "^9.36.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.12.4",
		"formsnap": "^2.0.1",
		"globals": "^16.4.0",
		"husky": "^9.1.7",
		"knip": "^5.83.1",
		"lucide-svelte": "^0.544.0",
		"mode-watcher": "^1.1.0",
		"paneforge": "^1.0.2",
		"patch-package": "^8.0.0",
		"prettier": "~3.6.2",
		"prettier-plugin-organize-imports": "^4.3.0",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"svelte": "^5.39.6",
		"svelte-check": "^4.3.2",
		"svelte-sonner": "^1.0.5",
		"sveltekit-superforms": "^2.27.1",
		"tailwind-merge": "^3.3.1",
		"tailwind-variants": "^3.1.1",
		"tailwindcss": "^4.1.13",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.44.1",
		"vaul-svelte": "^1.0.0-next.7",
		"vite": "^7.1.7",
		"vitepress": "^1.6.4",
		"vitest": "^3.2.4",
		"zod": "^4.1.11"
	},
	"dependencies": {
		"@ai-sdk/azure": "^2.0.38",
		"@ai-sdk/svelte": "^3.0.56",
		"@inlang/paraglide-sveltekit": "^0.16.1",
		"@sendgrid/mail": "^8.1.6",
		"@tiptap/core": "^3.6.1",
		"@tiptap/extension-bubble-menu": "^3.6.1",
		"@tiptap/extension-history": "^3.6.1",
		"@tiptap/extension-list-keymap": "^3.6.1",
		"@tiptap/extension-placeholder": "^3.6.1",
		"@tiptap/extension-task-item": "^3.6.1",
		"@tiptap/extension-task-list": "^3.6.1",
		"@tiptap/pm": "^3.6.1",
		"@tiptap/starter-kit": "^3.6.1",
		"ai": "^5.0.56",
		"better-auth": "^1.3.18",
		"dompurify": "^3.2.7",
		"drizzle-orm": "^0.44.5",
		"mammoth": "^1.11.0",
		"nanoid": "^5.1.6",
		"pdfjs-dist": "^5.4.149",
		"postgres": "^3.4.7",
		"winston": "^3.17.0",
		"xlsx": "^0.18.5"
	},
	"overrides": {
		"comment": "Override Zod v3 dependencies to use v4 to fix TypeScript conflicts between sveltekit-superforms (uses v3) and Better Auth (requires v4). See: https://github.com/ciscoheat/sveltekit-superforms/issues/630",
		"zod@^3.24.6": "^4.1.5"
	}
}
