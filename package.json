{
	"name": "sveltekit-vibe-starter",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev --host",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "prettier --check . && eslint .",
		"lint:format": "prettier --write . && eslint .",
		"test": "npm run test:unit && npm run test:integration && npm run test:e2e",
		"test:unit": "vitest run --project unit",
		"test:integration": "vitest run --project integration",
		"test:e2e": "playwright test",
		"test:e2e:ui-mode": "playwright test --ui",
		"test:e2e:failed": "playwright test --last-failed",
		"test:e2e:list": "playwright test --list",
		"test:e2e:show-report": "npx playwright show-report",
		"db:start": "docker compose up",
		"db:push": "drizzle-kit push",
		"db:push:force": "drizzle-kit push --force",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"psql:dev": "dotenv -e .env -- bash -c 'if [[ \"$DATABASE_URL\" =~ ^postgres://.*@(localhost|127\\.0\\.0\\.1|project-db): ]]; then psql \"$DATABASE_URL\" -c \"$@\"; else echo \"Error: Only localhost/project-db connections allowed for safety\"; exit 1; fi' --",
		"psql:test": "dotenv -e .env -- bash -c 'if [[ \"$TEST_DATABASE_URL\" =~ ^postgres://.*@(localhost|127\\.0\\.0\\.1|test-db): ]]; then psql \"$TEST_DATABASE_URL\" -c \"$@\"; else echo \"Error: Only localhost/test-db connections allowed for safety\"; exit 1; fi' --",
		"docs:dev": "vitepress dev docs",
		"docs:build": "vitepress build docs",
		"docs:preview": "vitepress preview docs"
	},
	"devDependencies": {
		"@eslint/compat": "^1.2.9",
		"@eslint/js": "^9.28.0",
		"@inlang/paraglide-js": "^2.3.2",
		"@inlang/plugin-m-function-matcher": "^0.9.36",
		"@inlang/plugin-message-format": "^2.2.0",
		"@internationalized/date": "^3.8.2",
		"@lucide/svelte": "^0.515.0",
		"@playwright/test": "^1.52.0",
		"@sveltejs/adapter-node": "^5.2.11",
		"@sveltejs/kit": "^2.21.2",
		"@sveltejs/vite-plugin-svelte": "^5.1.0",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/typography": "^0.5.16",
		"@tailwindcss/vite": "^4.1.8",
		"@tanstack/table-core": "^8.21.3",
		"@types/winston": "^2.4.4",
		"@zenai/playwright-coding-agent-reporter": "^1.1.2",
		"autoprefixer": "^10.4.20",
		"bits-ui": "^2.11.4",
		"clsx": "^2.1.1",
		"dotenv": "^16.5.0",
		"dotenv-cli": "^10.0.0",
		"drizzle-kit": "^0.31.1",
		"eslint": "^9.28.0",
		"eslint-config-prettier": "^10.1.5",
		"eslint-plugin-svelte": "^2.46.1",
		"formsnap": "^2.0.1",
		"globals": "^15.14.0",
		"lucide-svelte": "^0.513.0",
		"mode-watcher": "^1.1.0",
		"paneforge": "^1.0.0-next.5",
		"patch-package": "^8.0.0",
		"prettier": "^3.4.2",
		"prettier-plugin-organize-imports": "^4.1.0",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"svelte": "^5.33.14",
		"svelte-check": "^4.2.1",
		"svelte-sonner": "^1.0.5",
		"sveltekit-superforms": "^2.26.1",
		"tailwind-merge": "^3.3.0",
		"tailwind-variants": "^3.1.1",
		"tailwindcss": "^4.0.0",
		"tw-animate-css": "^1.3.4",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.33.1",
		"vaul-svelte": "^1.0.0-next.7",
		"vite": "^6.3.6",
		"vitepress": "^1.6.3",
		"vitest": "^3.2.1",
		"zod": "^3.25.30"
	},
	"dependencies": {
		"@ai-sdk/azure": "^2.0.24",
		"@ai-sdk/svelte": "^3.0.34",
		"@inlang/paraglide-sveltekit": "^0.15.5",
		"@sendgrid/mail": "^8.1.6",
		"@tiptap/core": "^3.4.1",
		"@tiptap/extension-bubble-menu": "^3.4.1",
		"@tiptap/extension-history": "^3.4.1",
		"@tiptap/extension-list-keymap": "^3.4.1",
		"@tiptap/extension-placeholder": "^3.4.1",
		"@tiptap/extension-task-item": "^3.4.1",
		"@tiptap/extension-task-list": "^3.4.1",
		"@tiptap/pm": "^3.4.1",
		"@tiptap/starter-kit": "^3.4.1",
		"ai": "^5.0.34",
		"better-auth": "^1.2.10",
		"dompurify": "^3.2.6",
		"drizzle-orm": "^0.44.2",
		"mammoth": "^1.10.0",
		"pdfjs-dist": "^5.4.54",
		"postgres": "^3.4.7",
		"winston": "^3.17.0",
		"xlsx": "^0.18.5"
	}
}
