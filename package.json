{
	"name": "sveltekit-vibe-starter",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "prettier --check . && eslint .",
		"lint:format": "prettier --write . && eslint .",
		"test:unit": "vitest run src/",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "dotenv -e .env.e2e -- bash -c 'npx drizzle-kit push --force && playwright test'",
		"test:e2e:ui-mode": "playwright test --ui",
		"db:start": "docker compose up",
		"db:push": "drizzle-kit push",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"docs:dev": "vitepress dev docs",
		"docs:build": "vitepress build docs",
		"docs:preview": "vitepress preview docs"
	},
	"devDependencies": {
		"@eslint/compat": "^1.2.9",
		"@eslint/js": "^9.28.0",
		"@internationalized/date": "^3.8.2",
		"@lucide/svelte": "^0.511.0",
		"@playwright/test": "^1.52.0",
		"@sveltejs/adapter-node": "^5.2.11",
		"@sveltejs/kit": "^2.21.2",
		"@sveltejs/vite-plugin-svelte": "^5.1.0",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/typography": "^0.5.16",
		"@tailwindcss/vite": "^4.1.8",
		"@tanstack/table-core": "^8.21.3",
		"autoprefixer": "^10.4.20",
		"bits-ui": "^2.4.1",
		"clsx": "^2.1.1",
		"dotenv": "^16.5.0",
		"dotenv-cli": "^10.0.0",
		"drizzle-kit": "^0.31.1",
		"eslint": "^9.28.0",
		"eslint-config-prettier": "^10.1.5",
		"eslint-plugin-svelte": "^2.46.1",
		"formsnap": "^2.0.1",
		"globals": "^15.14.0",
		"lucide-svelte": "^0.513.0",
		"mode-watcher": "^1.0.7",
		"paneforge": "^1.0.0-next.5",
		"prettier": "^3.4.2",
		"prettier-plugin-organize-imports": "^4.1.0",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"svelte": "^5.33.14",
		"svelte-check": "^4.2.1",
		"svelte-sonner": "^1.0.4",
		"sveltekit-superforms": "^2.26.1",
		"tailwind-merge": "^3.3.0",
		"tailwind-variants": "^1.0.0",
		"tailwindcss": "^4.0.0",
		"tw-animate-css": "^1.3.4",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.33.1",
		"vaul-svelte": "^1.0.0-next.7",
		"vite": "^6.3.5",
		"vitepress": "^1.6.3",
		"vitest": "^3.2.1",
		"zod": "^3.25.30"
	},
	"dependencies": {
		"@inlang/paraglide-sveltekit": "^0.15.5",
		"better-auth": "^1.2.10",
		"drizzle-orm": "^0.44.2",
		"postgres": "^3.4.7"
	}
}
