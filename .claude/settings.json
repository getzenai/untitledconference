{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"includeCoAuthoredBy": false,
	"permissions": {
		"allow": [
			"Bash(cat:*)",
			"Bash(find:*)",
			"Bash(gh pr view:*)",
			"Bash(git diff:*)",
			"Bash(grep:*)",
			"Bash(ls:*)",
			"Bash(mkdir:*)",
			"Bash(npm run build:*)",
			"Bash(npm run check:*)",
			"Bash(npm run format:*)",
			"Bash(npm run lint:*)",
			"Bash(npm run lint)",
			"Bash(npm run test:*)",
			"Bash(npm run test)",
			"Bash(npm test:*)",
			"Bash(npx cypress run:*)",
			"Bash(npx prettier:*)",
			"Bash(tmux capture-pane:*)",
			"Bash(tmux kill-session:*)",
			"Bash(tmux list-sessions:*)",
			"Bash(tmux ls:*)",
			"Bash(tmux new-session:*)",
			"Bash(tmux send-keys:*)",
			"mcp__github__get_issue_comments",
			"mcp__github__get_issue",
			"mcp__github__get_pull_request_comments",
			"mcp__github__get_pull_request_reviews",
			"mcp__github__search_issues",
			"mcp__playwright__browser_click",
			"mcp__playwright__browser_close",
			"mcp__playwright__browser_console_messages",
			"mcp__playwright__browser_evaluate",
			"mcp__playwright__browser_navigate",
			"mcp__playwright__browser_snapshot",
			"mcp__playwright__browser_type",
			"WebFetch(domain:ai-sdk.dev)",
			"WebFetch(domain:formsnap.dev)",
			"WebFetch(domain:milkdown.dev)",
			"WebFetch(domain:raw.githubusercontent.com)",
			"WebFetch(domain:superforms.rocks)",
			"WebFetch(domain:svelte.dev)",
			"WebFetch(domain:www.better-auth.com)",
			"WebFetch(domain:www.shadcn-svelte.com)",
			"WebFetch(domain:zod.dev)"
		],
		"deny": []
	},
	"enabledMcpjsonServers": ["playwright", "github", "svelte"],
	"extraKnownMarketplaces": {
		"svelte": {
			"source": {
				"source": "github",
				"repo": "sveltejs/ai-tools"
			}
		}
	},
	"enabledPlugins": {
		"svelte@svelte": true
	},
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": ".claude/hooks/block-destructive.sh",
						"timeout": 5
					},
					{
						"type": "command",
						"command": ".claude/hooks/remind-deep-review.sh",
						"timeout": 5
					}
				]
			},
			{
				"matcher": "Write|Edit|MultiEdit",
				"hooks": [
					{
						"type": "command",
						"command": ".claude/hooks/protect-files.sh",
						"timeout": 5
					},
					{
						"type": "command",
						"command": ".claude/hooks/enforce-spec-first.sh",
						"timeout": 5
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": ".claude/hooks/verify-tests.sh",
						"timeout": 120
					}
				]
			}
		],
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": ".claude/hooks/on-session-start.sh",
						"timeout": 10
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Write|Edit|MultiEdit",
				"hooks": [
					{
						"type": "command",
						"command": "file_path=$(jq -r '.tool_input.file_path'); if echo \"$file_path\" | grep -qE '\\.(ts|js|svelte|md|json)$'; then npx prettier --write \"$file_path\"; fi"
					},
					{
						"type": "command",
						"command": "jq -r '.tool_input.file_path' | { read file_path; if echo \"$file_path\" | grep -qE '\\.(ts|js|svelte)$'; then npx eslint \"$file_path\" 1>&2 || exit 2; fi; }"
					}
				]
			},
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": ".claude/hooks/check-doc-validation.sh",
						"timeout": 10
					}
				]
			}
		]
	}
}
