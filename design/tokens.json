{
	"$schema": "https://tr.designtokens.org/format/",
	"$description": "Untitled Conference design tokens. DTCG Design Tokens Format Module (v2025.10). This file is the source of truth; src/app.css is generated from it by scripts/build-tokens.ts. Never edit the generated block in app.css by hand. Modes are not part of the stable spec yet, so light and dark are modelled as two sibling groups.",
	"light": {
		"$type": "color",
		"background": { "$value": { "colorSpace": "oklch", "components": [1, 0, 0] } },
		"foreground": { "$value": { "colorSpace": "oklch", "components": [0.145, 0, 0] } },
		"card": { "$value": { "colorSpace": "oklch", "components": [1, 0, 0] } },
		"card-foreground": { "$value": { "colorSpace": "oklch", "components": [0.145, 0, 0] } },
		"popover": { "$value": { "colorSpace": "oklch", "components": [1, 0, 0] } },
		"popover-foreground": { "$value": { "colorSpace": "oklch", "components": [0.145, 0, 0] } },

		"primary": {
			"$value": { "colorSpace": "oklch", "components": [0.205, 0, 0] },
			"$description": "The action colour. A filled primary button is the one thing to do on a screen (R1)."
		},
		"primary-foreground": { "$value": { "colorSpace": "oklch", "components": [0.985, 0, 0] } },

		"act": {
			"$value": { "colorSpace": "oklch", "components": [0.78, 0.15, 85] },
			"$description": "The goose's bill. The one warm surface: the action that creates something (new conference, publish CFP, submit a talk) and the dot that marks something unseen. Always carries ink-black text, never white. Appears at most once per screen — on a goose the bill is a small part of the bird, and that ratio is the rule."
		},
		"act-foreground": { "$value": { "colorSpace": "oklch", "components": [0.145, 0, 0] } },

		"secondary": { "$value": { "colorSpace": "oklch", "components": [0.97, 0, 0] } },
		"secondary-foreground": { "$value": { "colorSpace": "oklch", "components": [0.205, 0, 0] } },
		"muted": { "$value": { "colorSpace": "oklch", "components": [0.97, 0, 0] } },
		"muted-foreground": {
			"$value": { "colorSpace": "oklch", "components": [0.5, 0, 0] },
			"$description": "Darkened from 0.556: on --muted it only reached 4.34:1, and the doc puts this pairing in every table header."
		},
		"accent": { "$value": { "colorSpace": "oklch", "components": [0.97, 0, 0] } },
		"accent-foreground": { "$value": { "colorSpace": "oklch", "components": [0.205, 0, 0] } },
		"destructive": { "$value": { "colorSpace": "oklch", "components": [0.577, 0.245, 27.325] } },
		"border": { "$value": { "colorSpace": "oklch", "components": [0.922, 0, 0] } },
		"input": { "$value": { "colorSpace": "oklch", "components": [0.922, 0, 0] } },
		"ring": {
			"$value": { "colorSpace": "oklch", "components": [0.45, 0, 0] },
			"$description": "Darkened from 0.708, which was 2.59:1 against white and failed WCAG 1.4.11 for a focus indicator."
		},

		"chart-1": {
			"$value": { "colorSpace": "oklch", "components": [0.55, 0.15, 255] },
			"$description": "Series slot 1, ours rather than the shadcn default. The stock pair hands the same series an orange in light mode and an indigo in dark, so a mark changed identity when the theme flipped. This is one hue (255) stepped per surface: L 0.55 on white, L 0.65 on the dark card. Both steps clear the lightness band, the chroma floor and 3:1 against their own surface. Slots 2-5 are still the stock pairs and are unused; step them the same way before reaching for one."
		},
		"chart-2": { "$value": { "colorSpace": "oklch", "components": [0.6, 0.118, 184.704] } },
		"chart-3": { "$value": { "colorSpace": "oklch", "components": [0.398, 0.07, 227.392] } },
		"chart-4": { "$value": { "colorSpace": "oklch", "components": [0.828, 0.189, 84.429] } },
		"chart-5": { "$value": { "colorSpace": "oklch", "components": [0.769, 0.188, 70.08] } },

		"sidebar": { "$value": { "colorSpace": "oklch", "components": [0.985, 0, 0] } },
		"sidebar-foreground": { "$value": { "colorSpace": "oklch", "components": [0.145, 0, 0] } },
		"sidebar-primary": { "$value": { "colorSpace": "oklch", "components": [0.205, 0, 0] } },
		"sidebar-primary-foreground": {
			"$value": { "colorSpace": "oklch", "components": [0.985, 0, 0] }
		},
		"sidebar-accent": { "$value": { "colorSpace": "oklch", "components": [0.97, 0, 0] } },
		"sidebar-accent-foreground": {
			"$value": { "colorSpace": "oklch", "components": [0.205, 0, 0] }
		},
		"sidebar-border": { "$value": { "colorSpace": "oklch", "components": [0.922, 0, 0] } },
		"sidebar-ring": { "$value": { "colorSpace": "oklch", "components": [0.45, 0, 0] } },

		"status-neutral": { "$value": { "colorSpace": "oklch", "components": [0.51, 0, 0] } },
		"status-neutral-bg": { "$value": { "colorSpace": "oklch", "components": [0.97, 0, 0] } },
		"status-progress": { "$value": { "colorSpace": "oklch", "components": [0.52, 0.16, 255] } },
		"status-progress-bg": { "$value": { "colorSpace": "oklch", "components": [0.96, 0.03, 255] } },
		"status-good": {
			"$value": { "colorSpace": "oklch", "components": [0.5, 0.13, 155] },
			"$description": "Success. Accepted, confirmed, approved, done."
		},
		"status-good-bg": { "$value": { "colorSpace": "oklch", "components": [0.96, 0.04, 155] } },
		"status-warn": {
			"$value": { "colorSpace": "oklch", "components": [0.53, 0.15, 55] },
			"$description": "Orange, and orange means warning here — nothing else does. Moved from hue 75 to 55 so it reads as orange next to the yellow act colour."
		},
		"status-warn-bg": { "$value": { "colorSpace": "oklch", "components": [0.965, 0.035, 60] } },
		"status-bad": { "$value": { "colorSpace": "oklch", "components": [0.53, 0.19, 20] } },
		"status-bad-bg": { "$value": { "colorSpace": "oklch", "components": [0.96, 0.03, 20] } },
		"status-internal": {
			"$value": { "colorSpace": "oklch", "components": [0.5, 0.17, 300] },
			"$description": "Never public. Anything wearing this is filtered out of every public surface and out of the reviewer's view (R6)."
		},
		"status-internal-bg": { "$value": { "colorSpace": "oklch", "components": [0.96, 0.03, 300] } }
	},
	"dark": {
		"$type": "color",
		"$description": "Reworked 2026-08-14 against the Zen Inspired Theme (tweakcn cmlm03etv000204lh15608kec), adapted rather than adopted. Two things came across: the surfaces are a ladder of six visible steps instead of two, and the ink is not white. What did not come across is Zen's warm neutrals — our one warm surface is the act colour, and a warm background would compete with the bill. So the surfaces stay achromatic and only the ink carries a whisper of hue 85, which is the same hue as the act.",
		"background": { "$value": { "colorSpace": "oklch", "components": [0.2, 0, 0] } },
		"foreground": {
			"$value": { "colorSpace": "oklch", "components": [0.92, 0.008, 85] },
			"$description": "Was 0.985 on a 0.145 background: 18.96:1, near the WCAG maximum and the reason dark mode read as harsh. 14.29:1 now, still three times the 4.5 the doc asks for."
		},
		"card": { "$value": { "colorSpace": "oklch", "components": [0.235, 0, 0] } },
		"card-foreground": { "$value": { "colorSpace": "oklch", "components": [0.92, 0.008, 85] } },
		"popover": { "$value": { "colorSpace": "oklch", "components": [0.235, 0, 0] } },
		"popover-foreground": { "$value": { "colorSpace": "oklch", "components": [0.92, 0.008, 85] } },

		"primary": { "$value": { "colorSpace": "oklch", "components": [0.87, 0.012, 85] } },
		"primary-foreground": { "$value": { "colorSpace": "oklch", "components": [0.235, 0, 0] } },

		"act": { "$value": { "colorSpace": "oklch", "components": [0.8, 0.14, 85] } },
		"act-foreground": { "$value": { "colorSpace": "oklch", "components": [0.145, 0, 0] } },

		"secondary": { "$value": { "colorSpace": "oklch", "components": [0.265, 0, 0] } },
		"secondary-foreground": {
			"$value": { "colorSpace": "oklch", "components": [0.92, 0.008, 85] }
		},
		"muted": { "$value": { "colorSpace": "oklch", "components": [0.285, 0, 0] } },
		"muted-foreground": { "$value": { "colorSpace": "oklch", "components": [0.705, 0.006, 85] } },
		"accent": { "$value": { "colorSpace": "oklch", "components": [0.325, 0, 0] } },
		"accent-foreground": { "$value": { "colorSpace": "oklch", "components": [0.92, 0.008, 85] } },
		"destructive": { "$value": { "colorSpace": "oklch", "components": [0.704, 0.191, 22.216] } },
		"border": {
			"$value": { "colorSpace": "oklch", "components": [0.3, 0, 0] },
			"$description": "Opaque, where it used to be white at 10%. A translucent border takes the lightness of whatever sits under it, so the same rule was a different rule on a card, a popover and the sidebar — and the contrast checker skips translucent tokens, so nothing measured it. One value, checked."
		},
		"input": { "$value": { "colorSpace": "oklch", "components": [0.34, 0, 0] } },
		"ring": { "$value": { "colorSpace": "oklch", "components": [0.65, 0, 0] } },

		"chart-1": {
			"$value": { "colorSpace": "oklch", "components": [0.65, 0.14, 255] },
			"$description": "The dark step of series slot 1 — see the light-mode note."
		},
		"chart-2": { "$value": { "colorSpace": "oklch", "components": [0.696, 0.17, 162.48] } },
		"chart-3": { "$value": { "colorSpace": "oklch", "components": [0.769, 0.188, 70.08] } },
		"chart-4": { "$value": { "colorSpace": "oklch", "components": [0.627, 0.265, 303.9] } },
		"chart-5": { "$value": { "colorSpace": "oklch", "components": [0.645, 0.246, 16.439] } },

		"sidebar": {
			"$value": { "colorSpace": "oklch", "components": [0.175, 0, 0] },
			"$description": "Below the background, not equal to the card. The rail recedes and the page floats on it; before, sidebar, card and popover were all one value and the shell had no depth at all."
		},
		"sidebar-foreground": { "$value": { "colorSpace": "oklch", "components": [0.92, 0.008, 85] } },
		"sidebar-primary": {
			"$value": { "colorSpace": "oklch", "components": [0.87, 0.012, 85] },
			"$description": "Was a saturated indigo, the stock shadcn value, with no caller anywhere in the tree. Retuned to match primary so that whoever first uses it gets the goose and not somebody else's brand."
		},
		"sidebar-primary-foreground": {
			"$value": { "colorSpace": "oklch", "components": [0.235, 0, 0] }
		},
		"sidebar-accent": { "$value": { "colorSpace": "oklch", "components": [0.285, 0, 0] } },
		"sidebar-accent-foreground": {
			"$value": { "colorSpace": "oklch", "components": [0.92, 0.008, 85] }
		},
		"sidebar-border": { "$value": { "colorSpace": "oklch", "components": [0.265, 0, 0] } },
		"sidebar-ring": { "$value": { "colorSpace": "oklch", "components": [0.65, 0, 0] } },

		"status-neutral": { "$value": { "colorSpace": "oklch", "components": [0.7, 0, 0] } },
		"status-neutral-bg": { "$value": { "colorSpace": "oklch", "components": [0.29, 0, 0] } },
		"status-progress": { "$value": { "colorSpace": "oklch", "components": [0.78, 0.11, 255] } },
		"status-progress-bg": { "$value": { "colorSpace": "oklch", "components": [0.29, 0.055, 255] } },
		"status-good": {
			"$value": { "colorSpace": "oklch", "components": [0.78, 0.11, 155] },
			"$description": "One ladder for all six badges: ink at L 0.78 C 0.11, plate at L 0.29 C 0.055, hue the only difference. They used to range from L 0.72 to 0.80 and C 0.12 to 0.15, so a row of badges had one shouting and one whispering for no reason a reader could name."
		},
		"status-good-bg": { "$value": { "colorSpace": "oklch", "components": [0.29, 0.055, 155] } },
		"status-warn": { "$value": { "colorSpace": "oklch", "components": [0.78, 0.11, 60] } },
		"status-warn-bg": { "$value": { "colorSpace": "oklch", "components": [0.29, 0.055, 60] } },
		"status-bad": { "$value": { "colorSpace": "oklch", "components": [0.78, 0.11, 20] } },
		"status-bad-bg": { "$value": { "colorSpace": "oklch", "components": [0.29, 0.055, 20] } },
		"status-internal": { "$value": { "colorSpace": "oklch", "components": [0.78, 0.11, 300] } },
		"status-internal-bg": { "$value": { "colorSpace": "oklch", "components": [0.29, 0.055, 300] } }
	},
	"$extensions": {
		"com.untitledconference.radius": "0.625rem",
		"com.untitledconference.contrast": {
			"$description": "Pairs that must hold, checked by scripts/build-tokens.ts and by the unit test. A palette without a check is a palette that drifts.",
			"pairs": [
				{ "fg": "primary-foreground", "bg": "primary", "min": 4.5 },
				{ "fg": "act-foreground", "bg": "act", "min": 4.5 },
				{ "fg": "foreground", "bg": "background", "min": 4.5 },
				{ "fg": "muted-foreground", "bg": "muted", "min": 4.5 },
				{ "fg": "status-neutral", "bg": "status-neutral-bg", "min": 4.5 },
				{ "fg": "status-progress", "bg": "status-progress-bg", "min": 4.5 },
				{ "fg": "status-good", "bg": "status-good-bg", "min": 4.5 },
				{ "fg": "status-warn", "bg": "status-warn-bg", "min": 4.5 },
				{ "fg": "status-bad", "bg": "status-bad-bg", "min": 4.5 },
				{ "fg": "status-internal", "bg": "status-internal-bg", "min": 4.5 },
				{ "fg": "ring", "bg": "background", "min": 3 },
				{ "fg": "border", "bg": "card", "min": 1.2 }
			]
		}
	}
}
