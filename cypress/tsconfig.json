{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"lib": ["ES2020", "DOM"],
		"types": ["cypress", "node"],
		"moduleResolution": "bundler",
		"esModuleInterop": true,
		"isolatedModules": true,
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": ["**/*.ts"],
	"exclude": ["node_modules"]
}
