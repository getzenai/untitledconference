# ============================================================
# Local Docker Mode
# ============================================================
# Uncomment these lines to use local Docker PostgreSQL instead of Cloud DB.
# All other secrets (auth, GitHub, SendGrid, OpenAI) still come from Infisical.
#
# Prerequisites:
#   docker compose up -d    # starts dev-db (port 5432) + test-db (port 5433)
#   infisical login          # still needed for remaining secrets
#
# DATABASE_URL="postgres://root:mysecretpassword@localhost:5432/dev"
# TEST_DATABASE_URL="postgres://root:mysecretpassword@localhost:5433/test"

# ============================================================
# Cloud DB Mode (default — no .env needed)
# ============================================================
# Just run: npm run dev
# All values including DATABASE_URL come from Infisical Cloud.

# ============================================================
# Optional overrides (both modes)
# ============================================================
# LOG_LEVEL="debug"
# LOG_FORMAT="human"

# Conference mail outbox (optional locally; both are required to deliver).
# RESEND_API_KEY="re_..."
# RESEND_FROM="Untitled Conference <conference@getzenai.com>"

# ============================================================
# Auth (optional)
# ============================================================
# WebAuthn relying-party ID for passkeys. Derived from BETTER_AUTH_URL's
# hostname (minus "www.") unless set. Only needed when the app is served from a
# deeper subdomain (e.g. app.example.com) and passkeys should stay valid across
# the registrable domain. Changing it invalidates all registered passkeys.
# BETTER_AUTH_PASSKEY_RP_ID="example.com"

# Allow OAuth clients to self-register (RFC 7591 dynamic client registration).
# Off by default: it lets unauthenticated callers create clients. Enable only if
# your deployment needs it (e.g. MCP clients).
# OAUTH_ALLOW_DYNAMIC_CLIENT_REGISTRATION="true"

# E2E-only: relax Better Auth's 3-per-10s rate limit on /sign-in* and /sign-up*.
# Never set this in a deployed environment.
# RELAX_AUTH_RATE_LIMIT="true"

# ============================================================
# Background jobs (pg-boss)
# ============================================================
# No dedicated env vars — the job queue reuses DATABASE_URL above. Both the web
# app and `npm run jobs:worker(:dev)` need it. pg-boss manages its own `pgboss`
# schema in that same database. See src/lib/server/jobs/CLAUDE.md.

# ============================================================
# Feature flags
# ============================================================
# One FEATURE_* variable per flag, off unless set to "true"/"1".
# See src/lib/server/feature-flags.ts.
# FEATURE_EXAMPLE_FEATURE="true"

# ============================================================
# Observability (all optional — off by default)
# ============================================================
# Everything below degrades to a no-op when unset, so `npm run build` and
# local development work without any of it.

# --- PostHog product analytics + error tracking ---
# Enables browser analytics, server-side event capture and error tracking.
# The project API key is not a secret; it ships to the browser.
# PUBLIC_POSTHOG_API_KEY="phc_..."
# PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"

# --- OpenTelemetry log export ---
# Ships Winston logs to an OTLP/HTTP collector. Configure EITHER a generic
# collector...
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT="https://collector.example.com/v1/logs"
# OTEL_EXPORTER_OTLP_LOGS_HEADERS="x-api-key=abc,x-tenant=acme"
#
# ...or PostHog log ingestion (falls back to PUBLIC_POSTHOG_API_KEY):
# POSTHOG_LOGS_TOKEN="phc_..."
# POSTHOG_HOST="https://eu.i.posthog.com"
#
# Resource attributes reported alongside every log record:
# OTEL_SERVICE_NAME="sveltekit-vibe-starter"
# OTEL_SERVICE_VERSION="$GIT_COMMIT_SHA"
# DEPLOYMENT_ENVIRONMENT="production"

# The full inventory of server variables — required, defaults and descriptions —
# lives in src/lib/env/server-env-schema.ts.
