# Development Database
DATABASE_URL="postgres://root:mysecretpassword@localhost:5432/local"

# Test Database (always on port 5433)
TEST_DATABASE_URL="postgres://root:mysecretpassword@localhost:5433/test"

# Better Auth Environment Variables
BETTER_AUTH_SECRET="your_strong_better_auth_secret_here" # Secret for Better Auth
BETTER_AUTH_URL="http://localhost:5173" # Base URL of your SvelteKit app (adjust if your dev port is different)
# Comma-separated list of trusted origins (development only - leave empty in production)
# In production, BETTER_AUTH_URL is trusted by default
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174"

# GitHub OAuth Provider (Optional - if you use GitHub social login)
GITHUB_CLIENT_ID="your_github_client_id_here"
GITHUB_CLIENT_SECRET="your_github_client_secret_here"

# Email Configuration
# By default, emails are logged to console. Set to 'true' to send actual emails via SendGrid
SEND_EMAILS_INSTEAD_OF_CONSOLE_LOG=false
# Email Verification
# Set to 'true' to allow unverified emails to access protected routes (useful for testing)
# Note: Verification emails are still sent, but the verification check is bypassed
ALLOW_UNVERIFIED_EMAIL=false
# SendGrid Configuration (only needed when SEND_EMAILS_INSTEAD_OF_CONSOLE_LOG=true)
SENDGRID_API_KEY="your_sendgrid_api_key"
SENDGRID_FROM="no-reply@yourdomain.com"

# Logging Configuration
# LOG_LEVEL controls the minimum log level shown. Options: debug, info, warn, error
# Default: 'warn' (regardless of environment)
LOG_LEVEL="warn"
# LOG_FORMAT controls the output format. Options: human, json
# Default: 'human' (colored, readable format)
# Use 'json' for machine-readable logs in production
LOG_FORMAT="human"

# AI Provider Configuration
# AI_PROVIDER can be "azure" or "mock" (defaults to "mock" if not set or Azure config is missing)
AI_PROVIDER="mock"

# Azure OpenAI Configuration (Required when AI_PROVIDER="azure")
AZURE_OPENAI_API_KEY="your_azure_openai_api_key"
AZURE_RESOURCE_NAME="your_azure_resource_name"
AZURE_OPENAI_DEPLOYMENT_NAME="your_deployment_name"
