# ============================================================
# Local Docker Mode
# ============================================================
# Uncomment these lines to use local Docker PostgreSQL instead of Azure DB.
# All other secrets (auth, GitHub, SendGrid, OpenAI) still come from Key Vault.
#
# Prerequisites:
#   docker compose up -d    # starts dev-db (port 5432) + test-db (port 5433)
#   az login                # still needed for KV secrets
#
# DATABASE_URL="postgres://root:mysecretpassword@localhost:5432/dev"
# TEST_DATABASE_URL="postgres://root:mysecretpassword@localhost:5433/test"

# ============================================================
# Azure DB Mode (default — no .env needed)
# ============================================================
# Just run: npm run dev
# All values including DATABASE_URL come from Azure Key Vault.

# ============================================================
# Optional overrides (both modes)
# ============================================================
# LOG_LEVEL="debug"
# LOG_FORMAT="human"
